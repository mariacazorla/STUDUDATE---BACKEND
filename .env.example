# Plantilla de variables de entorno.
# Cópiala con el nombre .env (cp .env.example .env). Tu .env no se sube a GitHub.

# Dirección de tu base de datos MongoDB.
# Con MongoDB instalado en tu ordenador, déjala tal cual.
# Con MongoDB Atlas, pega aquí la dirección que te da Atlas (empieza por mongodb+srv://).
MONGO_URL=mongodb://127.0.0.1:27017/studate

# Puerto de la API. Con 1337, la API responde en http://localhost:1337
SERVER_PORT=1337

# Desde qué direcciones se puede llamar a la API desde un navegador, separadas por comas:
# la web (Vite, puerto 5173) y la app de Expo abierta en el navegador (puerto 8081).
# Tienen que ser orígenes exactos (no vale *) porque el refresh token viaja en una cookie
# y CORS con credenciales exige orígenes concretos. La app del móvil no necesita estar aquí.
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Con production, la cookie del refresh token se marca como Secure (solo viaja por HTTPS).
# En clase se deja en development, porque todo va por http://localhost.
NODE_ENV=development

# Ruta de la cookie del refresh token. En local es /auth. En el servidor, nginx sirve la API
# detrás de /api y entonces tiene que ser /api/auth.
REFRESH_COOKIE_PATH=/auth

# Opcional: fuerza si la cookie es Secure (true o false). Si no se pone, es Secure solo con
# NODE_ENV=production. Sirve para probar el contenedor de producción por http.
# COOKIE_SECURE=false

# Secretos con los que se firman los tokens JWT: uno para el access token y otro para el refresh token.
# Tienen que ser distintos. Estos valores sirven para clase; en un servidor real se usa un texto
# largo y aleatorio, por ejemplo el que da: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=studate-access-secret-cambiame
JWT_REFRESH_SECRET=studate-refresh-secret-cambiame

# Cuánto dura cada token: 15m son 15 minutos, 7d son 7 días.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
